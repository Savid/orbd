# arm64 additions to orbd.config, applied after arm64's defconfig. For QEMU's `virt`
# machine (Apple Silicon hosts with HVF): PL011 serial console (ttyAMA0), PL031 clock,
# generic ECAM PCI host.

CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_PCI_HOST_GENERIC=y

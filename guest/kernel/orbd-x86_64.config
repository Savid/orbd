# x86_64 additions to orbd.config, applied after x86_64_defconfig and kvm_guest.config.

# Serial console (ttyS0), CMOS clock, KVM paravirtualization
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT_CLOCK=y

# Nested virtualization on Intel and AMD hosts
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y

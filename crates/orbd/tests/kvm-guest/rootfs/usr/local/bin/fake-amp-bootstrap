#!/bin/bash
# Stands in for `amp orb bootstrap`: proves the credentials arrived, never prints them.
echo "fake-amp-bootstrap: ORB_TOKEN has ${#ORB_TOKEN} chars"
# Active LSMs, read as the unprivileged user (needs securityfs, which systemd mounts).
echo "guest lsm: $(cat /sys/kernel/security/lsm 2>&1)"
# Landlock ABI version: landlock_create_ruleset(NULL, 0, LANDLOCK_CREATE_RULESET_VERSION),
# syscall 444 on x86_64 and arm64 (perl-base is essential, so always present).
echo "guest landlock abi: $(perl -e 'print syscall(444, 0, 0, 1)' 2>&1)"
# E2E_RESOLVE="name ...": what each name resolves to (`resolve <name> <address ...>`, or
# `unresolved`). Three tries: right after boot resolv.conf can still be orbd-test-dns's.
resolve() {
    local try a
    for try in 1 2 3; do
        a=$(timeout 6 getent ahostsv4 "$1" | while read -r addr kind _; do
            [ "$kind" = STREAM ] && printf '%s ' "$addr"
        done)
        [ -n "$a" ] && break
        sleep 1
    done
    printf '%s' "$a"
}
# Every lookup and probe runs at once (a dropped one waits out its 5 s); each prints one
# line.
for name in $E2E_RESOLVE; do
    { a=$(resolve "$name"); echo "resolve $name ${a:-unresolved}"; } &
done
# E2E_PROBE="host:port ...": which TCP destinations this orb reaches (open: accepted;
# refused: reachable, nothing listening; dropped: filtered; unresolved: a name that
# does not resolve).
probe() {
    local host=${1%:*} r
    if [[ ! $host =~ ^[0-9.]+$ ]] && [ -z "$(resolve "$host")" ]; then
        echo "probe $1 unresolved"
        return
    fi
    timeout 5 bash -c "exec 3<>/dev/tcp/$host/${1##*:}" 2>/dev/null
    case $? in 0) r=open ;; 124) r=dropped ;; *) r=refused ;; esac
    echo "probe $1 $r"
}
for target in $E2E_PROBE; do
    probe "$target" &
done
# E2E_UDP="host:port ...": one UDP datagram to each (whether it passed shows only in the
# agent's flow log).
udp() {
    local host=${1%:*} a
    if [[ ! $host =~ ^[0-9.]+$ ]]; then
        a=$(resolve "$host")
        if [ -z "$a" ]; then
            echo "udp $1 unresolved"
            return
        fi
        host=${a%% *}
    fi
    echo probe 2>/dev/null >"/dev/udp/$host/${1##*:}"
    echo "udp $1 sent"
}
for target in $E2E_UDP; do
    udp "$target" &
done
# E2E_PROBE6="address/port ...": TCP to IPv6 destinations, as E2E_PROBE.
probe6() {
    local r
    timeout 5 bash -c "exec 3<>/dev/tcp/${1%/*}/${1##*/}" 2>/dev/null
    case $? in 0) r=open ;; 124) r=dropped ;; *) r=refused ;; esac
    echo "probe6 $1 $r"
}
for target in $E2E_PROBE6; do
    probe6 "$target" &
done
wait
exec sleep infinity
